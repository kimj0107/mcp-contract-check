{
  "name": "@kimj0107/mcp-contract-check",
  "version": "0.1.0",
  "description": "Snapshot MCP tool inputs and gate breaking schema drift in CI.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=24" },
  "bin": { "mcp-contract-check": "dist/src/cli.js" },
  "exports": {
    ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" }
  },
  "files": ["dist/src", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepack": "npm run build",
    "demo": "npm run build && node dist/src/cli.js --help",
    "smoke:package": "node scripts/consumer-smoke.mjs"
  },
  "dependencies": { "@modelcontextprotocol/client": "2.4.0" },
  "devDependencies": { "@types/node": "26.6.6", "typescript": "7.0.2" }
}
